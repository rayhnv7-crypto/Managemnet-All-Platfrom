# Supabase project settings (server only; never use NEXT_PUBLIC_ prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key encoded as 64 hex characters. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Set to https://clipper-hub-rayhan.vercel.app
OAUTH_REDIRECT_BASE=

# Provider credentials from each official developer console
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional admin API for managing provider credentials/API keys
CLIPPER_ADMIN_SECRET=
